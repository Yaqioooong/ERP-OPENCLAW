# 统一换行符：仓库内按 LF 存储，检出到工作区也用 LF
* text=auto eol=lf

# UTF-16 编码文件，禁止 Git 做文本/换行符转换
requirements.txt -text

# Windows 批处理必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须是 LF，否则 Linux 下会报 bad interpreter
*.sh text eol=lf

# 二进制资源：不做 diff，也不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.pptx binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
